9d4JuiQocfhoMewg","name":"Silken Ceremonial","kind":"armor","category":"lightArmor","ac":1,"maxDex":null,"acp":0,"asf":0,"price":30,"weight":4,"desc":"","source":{"book":"Ultimate Equipment","page":"9"}},{"id":"tCw8lthSpIXzvCOj","name":"Spider-Silk Bodysuit","kind":"armor","category":"lightArmor","ac":3,"maxDex":6,"acp":1,"asf":10,"price":850,"weight":4,"desc":""},{"id":"xeuREriTfdZR1yCD","name":"Studded Leather Armor","kind":"armor","category":"lightArmor","ac":3,"maxDex":5,"acp":1,"asf":15,"price":25,"weight":20,"desc":"","source":{"book":"Core Rulebook","page":"151, 153"}},{"id":"juheM3y42yQrYbB9","name":"Varisian dancing scarves","kind":"armor","category":"lightArmor","ac":2,"maxDex":null,"acp":0,"asf":0,"price":150,"weight":8,"desc":"","source":{"book":"Adventurer's Armory 2","page":"6"}},{"id":"yLlOfnD759pfPms8","name":"Wooden Armor","kind":"armor","category":"lightArmor","ac":3,"maxDex":3,"acp":1,"asf":15,"price":20,"weight":25,"desc":""},{"id":"q2HbIx7a7YpGJ3Kn","name":"Agile Breastplate","kind":"armor","category":"mediumArmor","ac":6,"maxDex":3,"acp":4,"asf":25,"price":400,"weight":25,"desc":"","source":{"book":"Ultimate Equipment","page":"9"}},{"id":"mJYWI4VZBo0c0CCC","name":"Armored Coat","kind":"armor","category":"mediumArmor","ac":4,"maxDex":3,"acp":2,"asf":20,"price":50,"weight":20,"desc":"","source":{"book":"Ultimate Equipment","page":"9"}},{"id":"5TzaS38RPAx1oj9p","name":"Breastplate","kind":"armor","category":"mediumArmor","ac":6,"maxDex":3,"acp":4,"asf":25,"price":200,"weight":30,"desc":"","source":{"book":"Core Rulebook","page":"150, 151"}},{"id":"jmMTKB2OeTB4dUvm","name":"Chain Coat","kind":"armor","category":"mediumArmor","ac":4,"maxDex":5,"acp":2,"asf":30,"price":75,"weight":40,"desc":"","source":{"book":"Adventurer's Armory 2","page":"6"}},{"id":"unY9jt1B8a5bbnzO","name":"Chainmail","kind":"armor","category":"mediumArmor","ac":6,"maxDex":2,"acp":5,"asf":30,"price":150,"weight":40,"desc":"","source":{"book":"Core Rulebook","page":"150, 151"}},{"id":"B8H87SCG0E8n0iqw","name":"Do-Maru","kind":"armor","category":"mediumArmor","ac":5,"maxDex":4,"acp":4,"asf":25,"price":200,"weight":30,"desc":"","source":{"book":"Ultimate Equipment","page":"9"}},{"id":"LvqGhztGDLYS9QES","name":"Erutaki Coat","kind":"armor","category":"mediumArmor","ac":4,"maxDex":3,"acp":2,"asf":20,"price":80,"weight":24,"desc":"","source":{"book":"Adventurer's Armory 2","page":"6"}},{"id":"bP0vKIfcGKDgtiUc","name":"Four-Mirror","kind":"armor","category":"mediumArmor","ac":6,"maxDex":2,"acp":5,"asf":30,"price":125,"weight":45,"desc":"","source":{"book":"Ultimate Equipment","page":"9"}},{"id":"aI6gSI7gnCLCucw0","name":"Hide Armor","kind":"armor","category":"mediumArmor","ac":4,"maxDex":4,"acp":3,"asf":20,"price":15,"weight":25,"desc":"","source":{"book":"Core Rulebook","page":"151"}},{"id":"8e7QxmuuvJLpoGQO","name":"Horn Lamellar","kind":"armor","category":"mediumArmor","ac":5,"maxDex":3,"acp":4,"asf":25,"price":100,"weight":30,"desc":"","source":{"book":"Ultimate Equipment","page":"9"}},{"id":"q73l4hJuDIREmqDJ","name":"Kikko","kind":"armor","category":"mediumArmor","ac":5,"maxDex":4,"acp":3,"asf":20,"price":250,"weight":25,"desc":"","source":{"book":"Ultimate Equipment","page":"9"}},{"id":"wVKTG7gN2I8jalGg","name":"Mountain Pattern","kind":"armor","category":"mediumArmor","ac":6,"maxDex":3,"acp":4,"asf":30,"price":250,"weight":40,"desc":"","source":{"book":"Ultimate Equipment","page":"9"}},{"id":"nnDSj5NxUb9Q8z8S","name":"Scale Mail","kind":"armor","category":"mediumArmor","ac":5,"maxDex":3,"acp":4,"asf":25,"price":50,"weight":30,"desc":"","source":{"book":"Core Rulebook","page":"151"}},{"id":"Nt2xduBMY9qmPOMg","name":"Steel Lamellar","kind":"armor","category":"mediumArmor","ac":6,"maxDex":3,"acp":5,"asf":25,"price":150,"weight":35,"desc":"","source":{"book":"Ultimate Combat","page":"128"}},{"id":"olBieN7p2yJWgDW4","name":"Armor of Insults","kind":"armor","category":"lightArmor","ac":3,"maxDex":5,"acp":1,"asf":15,"price":16175,"weight":20,"desc":"<p>This is a suit of +1 <em class=\"ref\">studded leather</em>. Once per day the wearer of the armor may command the mouths to unleash a torrent of verbal abuse directed against every hostile creature within 60 feet who can see and hear the wearer. Each such creature must make a DC 16 Will saving throw to avoid suffering an overwhelming compulsion to attack the wearer for the next 7 rounds. If the creature is unable to attack the wearer on its next turn, or attacking the wearer would put the creature at risk (moving through a threatened square, charging into a pit, and so on) it can act normally that turn. This is a mind-affecting sonic effect, and has no effect on creatures that do not use a spoken language.</p>","source":{"book":"Ultimate Equipment","page":"124"}},{"id":"rqSC4rXoO3EaCxjw","name":"Armor of the Tireless Warrior","kind":"armor","category":"lightArmor","ac":2,"maxDex":6,"acp":0,"asf":10,"price":25900,"weight":15,"desc":"<p>Crafted by shamans of the Yumogu tribe for their mightiest chieftains, this is a +3 <em class=\"ref\">leather armor</em>. While her enemies tire around her, the wearer of this armor can keep fighting. If the wearer is a barbarian, the armor of the tireless warrior allows her to rage for 2 additional rounds per day. Once per day on command, the wearer can cause her enemies to become fatigued, as per the <em class=\"ref\">waves of fatigue</em> spell. In addition, once per day, the wearer can draw upon the armor's strength to banish her own weariness. For 10 minutes, the wearer takes no penalties from the fatigued or exhausted conditions. This effect is merely an illusion, however, and when it ends, the wearer takes 1d6 points of nonlethal damage and the condition or conditions return.</p>","source":{"book":"Jade Regent #5: Tide of Honor","page":"60"}},{"id":"tr9lrhc6xYJrQfeL","name":"Do-Maru of Broken Flesh","kind":"armor","category":"mediumArmor","ac":5,"maxDex":4,"acp":4,"asf":25,"price":20550,"weight":30,"desc":"<p>Once per day as a standard action, the wearer of this +2 <em class=\"ref\">do-maru</em> armor can activate the armor to heal 4d8+9 points of damage and end any and all of the following conditions affecting the wearer: ability damage, blinded, confused, dazzled, deafened, diseased, exhausted, fatigued, nauseated, poisoned, and sickened. In addition, this effect functions as break enchantment upon a single additional effect of the wearer's choice that is affecting the wearer and that can be legally affected by this effect. Such healing, however, comes at a cost. The do-maru of broken flesh creates vivid, ugly scars on the wearer, who takes 1d4 points of Charisma damage each time this ability is used.</p>","source":{"book":"Jade Regent #4: Forest of Spirits","page":"60"}},{"id":"aXXjidT6mFzdTsNT","name":"Elven Chain","kind":"armor","category":"mediumArmor","ac":6,"maxDex":4,"acp":3,"asf":20,"price":1150,"weight":40,"desc":"","source":{"book":"Ultimate Equipment","page":"126"}},{"id":"FHquac6fZEAhUy0q","name":"Ghost Mirror Armor","kind":"armor","category":"mediumArmor","ac":6,"maxDex":2,"acp":5,"asf":30,"price":22675,"weight":45,"desc":"<p>Crafted by Uqtaal spirit-shamans, this is an ancient +1 <em class=\"ref\">ghost touch</em> <em class=\"ref\">four-mirror</em> armor. The wearer of ghost mirror armor can cast deathwatch (caster level 1st) three times per day. In addition, when the wearer is attacked by an incorporeal undead creature, the armor automatically casts protection from evil on the wearer as an immediate action up to once per day.</p>","source":{"book":"Jade Regent #3: The Hungry Storm","page":"62"}},{"id":"oVNh5HY9w7AdmNzB","name":"O-Yoroi of Imperial Rule","kind":"armor","category":"heavyArmor","ac":8,"maxDex":2,"acp":6,"asf":35,"price":34550,"weight":45,"desc":"<p>This distinctive +4 adamantine <em class=\"ref\">glamered</em> <em class=\"ref\">o-yoroi</em> was designed for scions of Minkai's imperial families and their highest-ranking and most loyal samurai, providing its wearer with DR 3/-. In addition, the armor stores the kinetic energy from blows made against it. Once the armor has negated 15 total points of damage, the wearer can release the stored energy as a swift action against a single creature within 10 feet. This energy takes the form of a force effect, and the wearer must make an attack roll at his base attack bonus +10. The energy deals 15 points of force damage to the target, and the target must make a DC 22 Fortitude save or be stunned for 1 round. If the wearer chooses not to release this energy, the armor still provides damage reduction but absorbs no more energy until the stored energy is released.</p>","source":{"book":"Jade Regent #6: The Empty Throne","page":"60"}},{"id":"gsE0PAOmCwivue5A","name":"Buckler","kind":"shield","category":"other","ac":1,"maxDex":null,"acp":1,"asf":5,"price":5,"weight":5,"desc":"","source":{"book":"Core Rulebook","page":"150, 151"}},{"id":"inF1zaK0XoeTdBIc","name":"Dwarven War-Shield","kind":"shield","category":"other","ac":1,"maxDex":null,"acp":1,"asf":20,"price":50,"weight":8,"desc":"","source":{"book":"Adventurer's Armory 2","page":"9"}},{"id":"2fK608aSYU9QDmzw","name":"Heavy Steel Shield","kind":"shield","category":"heavyShield","ac":2,"maxDex":null,"acp":2,"asf":15,"price":20,"weight":15,"desc":"","source":{"book":"Core Rulebook","page":"142, 148, 151-152"}},{"id":"6zjwZeZmhqmAFC82","name":"Heavy Wooden Shield","kind":"shield","category":"heavyShield","ac":2,"maxDex":null,"acp":2,"asf":15,"price":7,"weight":10,"desc":"","source":{"book":"Core Rulebook","page":"151-152"}},{"id":"mDqCTp8wMKbSOo1x","name":"Klar","kind":"shield","category":"lightShield","ac":1,"maxDex":null,"acp":1,"asf":5,"price":12,"weight":6,"desc":"","source":{"book":"Ultimate Equipment","page":"18"}},{"id":"kc4ZuOEIEx1ZlXgJ","name":"Leather Madu","kind":"shield","category":"lightShield","ac":1,"maxDex":null,"acp":2,"asf":5,"price":40,"weight":5,"desc":"","source":{"book":"Ultimate Equipment","page":"20"}},{"id":"z5iAeUTo3r6qlEfd","name":"Light Steel Shield (Quickdraw)","kind":"shield","category":"lightShield","ac":1,"maxDex":null,"acp":2,"asf":5,"price":59,"weight":7,"desc":"","source":{"book":"Ultimate Equipment","page":"9"}},{"id":"iRB7ACzHf14VIk4M","name":"Light Steel Shield","kind":"shield","category":"lightShield","ac":1,"maxDex":null,"acp":1,"asf":5,"price":9,"weight":6,"desc":"","source":{"book":"Core Rulebook","page":"142, 148, 151, 152"}},{"id":"mcDNhbR4RQ5Z1ckQ","name":"Light Wooden Shield (Quickdraw)","kind":"shield","category":"lightShield","ac":1,"maxDex":null,"acp":2,"asf":5,"price":53,"weight":6,"desc":"","source":{"book":"Ultimate Equipment","page":"9"}},{"id":"l1qNkx4xGXelq6yY","name":"Light Wooden Shield","kind":"shield","category":"lightShield","ac":1,"maxDex":null,"acp":1,"asf":5,"price":3,"weight":5,"desc":"","source":{"book":"Core Rulebook","page":"142, 148, 151, 152"}},{"id":"J3o844mQGeLhJk0V","name":"Poisoner's Buckler","kind":"shield","category":"other","ac":1,"maxDex":null,"acp":0,"asf":0,"price":5,"weight":6,"desc":"","source":{"book":"Heroes from the Fringe","page":"23"}},{"id":"h8Jq6rEHJ8xc4SIn","name":"Steel Madu","kind":"shield","category":"lightShield","ac":1,"maxDex":null,"acp":2,"asf":5,"price":50,"weight":6,"desc":"","source":{"book":"Ultimate Equipment","page":"20"}},{"id":"Lq7YjIXW1SfV4EKr","name":"Steel Snarlshield","kind":"shield","category":"heavyShield","ac":2,"maxDex":null,"acp":3,"asf":15,"price":50,"weight":20,"desc":"","source":{"book":"Adventurer's Armory 2","page":"6"}},{"id":"3mQTIhwAaZgvJq12","name":"Tower Shield","kind":"shield","category":"towerShield","ac":4,"maxDex":2,"acp":10,"asf":50,"price":30,"weight":45,"desc":"","source":{"book":"Ultimate Equipment","page":"9"}},{"id":"OZHfmAh4i6Bkoun3","name":"Wooden Snarlshield","kind":"shield","category":"heavyShield","ac":2,"maxDex":null,"acp":3,"asf":15,"price":50,"weight":20,"desc":"","source":{"book":"Adventurer's Armory 2","page":"6"}}]